{
  "rewrites": [
    { "source": "/.netlify/functions/:match*", "destination": "/api/:match*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "netlify/**",
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
