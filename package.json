  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:netlify": "netlify dev -c \"npm run dev\"",
    "dev:host": "HOST=0.0.0.0 netlify dev -c \"npm run dev\"",
    "prebuild": "node scripts/update-sitemap.mjs",
    "build": "cross-env NODE_ENV=production vite build",
    "test": "vitest",
    "supabase:update-types": "supabase gen types typescript --local > src/types/supabase.ts",
    "supabase:test": "supabase test db",
    "supabase:sync": "supabase db reset && npm run supabase:update-types && npm run supabase:test",
    "supabase:watch": "chokidar 'supabase/migrations/*.sql' 'supabase/tests/*.sql' -c 'npm run supabase:sync'",
    "lint": "eslint .",
    "preview": "vite preview"
  },
