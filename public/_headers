/*
	HTML (always check for fresh content)
/index.html
	Cache-Control: public, max-age=0, must-revalidate
/*.html
	Cache-Control: public, max-age=0, must-revalidate

	# Long-lived immutable assets (build outputs typically include a content hash)
/assets/*
	Cache-Control: public, max-age=31536000, immutable
/*.js
	Cache-Control: public, max-age=31536000, immutable
/*.css
	Cache-Control: public, max-age=31536000, immutable
/*.svg
	Cache-Control: public, max-age=31536000, immutable
/*.(png|jpg|jpeg|gif|webp|avif|ico|json|woff2|woff|ttf|eot)
	Cache-Control: public, max-age=31536000, immutable

	# Manifest and icons
/site.webmanifest
	Cache-Control: public, max-age=31536000, immutable
/favicon.ico
	Cache-Control: public, max-age=31536000, immutable

	# API/endpoints should not be cached by CDN broadly
/api/*
	Cache-Control: no-store

