/*
	HTML (always check for fresh content)
/index.html
	Cache-Control: public, max-age=0, must-revalidate
/*.html
	Cache-Control: public, max-age=0, must-revalidate
/*.xml
	Cache-Control: public, max-age=0, must-revalidate
	Content-Type: application/xml

	# Long-lived immutable assets (build outputs typically include a content hash)
/assets/*
	Cache-Control: public, max-age=31536000, immutable
/*.js
	Cache-Control: public, max-age=31536000, immutable
/*.css
	Cache-Control: public, max-age=31536000, immutable
/*.svg
	Cache-Control: public, max-age=31536000, immutable
/*.(png|jpg|jpeg|gif|webp|avif|ico|json|woff2|woff|ttf|eot)
	Cache-Control: public, max-age=31536000, immutable

	# Manifest and icons
/site.webmanifest
	Cache-Control: public, max-age=31536000, immutable
/favicon.ico
	Cache-Control: public, max-age=31536000, immutable

/* Top-level icons and image assets (explicit) */
/android-chrome-192x192.png
	Cache-Control: public, max-age=31536000, immutable
/android-chrome-512x512.png
	Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
	Cache-Control: public, max-age=31536000, immutable
/favicon-16x16.png
	Cache-Control: public, max-age=31536000, immutable
/favicon-32x32.png
	Cache-Control: public, max-age=31536000, immutable
/favicon-96x96.png
	Cache-Control: public, max-age=31536000, immutable
/favicon.svg
	Cache-Control: public, max-age=31536000, immutable
/web-app-manifest-192x192.png
	Cache-Control: public, max-age=31536000, immutable
/web-app-manifest-512x512.png
	Cache-Control: public, max-age=31536000, immutable

/* Storage and CDN-like folders (often large assets) */
/storage/*
	Cache-Control: public, max-age=31536000, immutable
/ricorrenza.fun-cd7/*
	Cache-Control: public, max-age=31536000, immutable

	# API/endpoints should not be cached by CDN broadly
/api/*
	Cache-Control: no-store

