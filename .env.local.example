# Copy to .env.local and fill with your Supabase project values

# Client-side (Vite) envs
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Serverless functions (Netlify) envs
# Needed for /.netlify/functions/create-admin and /.netlify/functions/grant-permissions
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE=your-service-role-secret
# Copy this to .env.local (for local dev) and to Netlify env variables (for prod)
# Supabase Project URL (no trailing slash)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon Public Key
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# After setting these locally, restart the dev server.
# On Netlify, set in Site settings > Build & deploy > Environment > Environment variables, then trigger a redeploy.

# Optional: increase initial connection warmup (ms) to suppress early degraded/offline banner
# Defaults to 40000 (40s). You can shorten/extend if your backend is slower/faster to wake up.
VITE_CONNECTION_WARMUP_MS=40000
